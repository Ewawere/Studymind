// StudyMind Prisma Schema
// PostgreSQL (Supabase) + Prisma
//
// Workflow: npx prisma migrate dev --name <description>

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  clerkId       String    @unique
  email         String    @unique
  firstName     String?
  lastName      String?
  imageUrl      String?
  phone         String?

  country       String?
  curriculumId  String?
  curriculum    Curriculum? @relation(fields: [curriculumId], references: [id])
  level         String? // academic: SS1, SS2, SS3…
  primaryFocus  String?
  stressPoint   String?
  targetExamDate DateTime?
  weakSubjects  String[]
  learningGoals String[]
  preferredExplanationStyle String?
  dailyStudyTargetMin Int?
  timezone      String?
  onboardingDone Boolean  @default(false)

  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastStudyDate DateTime?
  totalStudyMinutes Int   @default(0)

  xp            Int       @default(0)
  playerLevel   Int       @default(1)

  plan          Plan      @default(FREE)
  planExpiresAt DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subjectMasteries SubjectMastery[]
  conceptStates    ConceptState[]
  studyPlans       StudyPlan[]
  quizAttempts     QuizAttempt[]
  questionAttempts QuestionAttempt[]
  conversations    Conversation[]
  learningEvents   LearningEvent[]
  examDeadlines    ExamDeadline[]
  subscriptions    Subscription[]
  questionImports  QuestionImport[]

  @@index([clerkId])
  @@index([email])
  @@index([curriculumId])
  @@index([onboardingDone])
}

enum Plan {
  FREE
  PRO
  EXAM_PASS
}

model Curriculum {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  country     String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subjects  Subject[]
  users     User[]
  questions Question[]

  @@index([code])
}

model Subject {
  id           String     @id @default(cuid())
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  code         String
  name         String
  description  String?
  order        Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  topics           Topic[]
  questions        Question[]
  subjectMasteries SubjectMastery[]
  studyPlanItems   StudyPlanItem[]
  examDeadlines    ExamDeadline[]

  @@unique([curriculumId, code])
  @@index([curriculumId])
}

model Topic {
  id          String   @id @default(cuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  concepts       Concept[]
  questions      Question[]
  studyPlanItems StudyPlanItem[]

  @@index([subjectId])
}

model Concept {
  id          String   @id @default(cuid())
  topicId     String
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  name        String
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conceptStates    ConceptState[]
  questions        Question[]
  questionConcepts QuestionConcept[]

  prerequisitesFrom ConceptRelation[] @relation("ConceptFrom")
  prerequisitesTo   ConceptRelation[] @relation("ConceptTo")

  @@index([topicId])
}

model ConceptRelation {
  id             String @id @default(cuid())
  fromConceptId  String
  toConceptId    String
  relationType   String @default("prerequisite")
  strength       Float  @default(1.0)

  fromConcept Concept @relation("ConceptFrom", fields: [fromConceptId], references: [id], onDelete: Cascade)
  toConcept   Concept @relation("ConceptTo", fields: [toConceptId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([fromConceptId, toConceptId, relationType])
  @@index([fromConceptId])
  @@index([toConceptId])
  @@index([relationType])
}

model SubjectMastery {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId          String
  subject            Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  masteryScore       Float    @default(0)
  confidence         Float    @default(0)
  questionsAttempted Int      @default(0)
  questionsCorrect   Int      @default(0)
  lastPracticedAt    DateTime?
  updatedAt          DateTime @updatedAt

  @@unique([userId, subjectId])
  @@index([userId])
  @@index([subjectId])
}

model ConceptState {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  conceptId      String
  concept        Concept   @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  masteryScore   Float     @default(0)
  confidence     Float     @default(0)
  easeFactor     Float     @default(2.5)
  intervalDays   Int       @default(0)
  repetitions    Int       @default(0)
  nextReviewAt   DateTime?
  lastReviewedAt DateTime?
  recentResults  String    @default("")
  updatedAt      DateTime  @updatedAt

  @@unique([userId, conceptId])
  @@index([userId])
  @@index([conceptId])
  @@index([nextReviewAt])
}

model LearningEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type])
}

model StudyPlan {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String?
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean   @default(true)
  generatedBy String    @default("system")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  items       StudyPlanItem[]

  @@index([userId, isActive])
}

model StudyPlanItem {
  id           String    @id @default(cuid())
  planId       String
  plan         StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  subjectId    String?
  subject      Subject?  @relation(fields: [subjectId], references: [id])
  topicId      String?
  topic        Topic?    @relation(fields: [topicId], references: [id])
  title        String
  description  String?
  type         String
  durationMin  Int       @default(20)
  scheduledFor DateTime
  completedAt  DateTime?
  order        Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([planId])
  @@index([scheduledFor])
}

model ExamDeadline {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])
  title     String
  examDate  DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([examDate])
}

enum QuestionType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
  ESSAY
  TRUE_FALSE
  PRACTICAL
  FLASHCARD
}

enum QuestionStatus {
  ACTIVE
  ARCHIVED
  DRAFT
  DUPLICATE_FLAGGED
}

model Question {
  id           String         @id @default(cuid())
  curriculumId String
  curriculum   Curriculum     @relation(fields: [curriculumId], references: [id])
  subjectId    String
  subject      Subject        @relation(fields: [subjectId], references: [id])
  topicId      String?
  topic        Topic?         @relation(fields: [topicId], references: [id])
  conceptId    String?
  concept      Concept?       @relation(fields: [conceptId], references: [id])

  type         QuestionType   @default(MULTIPLE_CHOICE)
  status       QuestionStatus @default(ACTIVE)
  language     String         @default("en")

  stem         String
  stemHash     String?
  correctKey   String?

  authorDifficulty     Int   @default(3)
  calculatedDifficulty Float?

  explanation          String?
  commonMistakes       Json?
  learningObjectives   String[]
  estimatedTimeSec     Int?
  source               String?
  year                 Int?
  bloomLevel           String?
  keywords             String[]

  revisionNumber Int      @default(1)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  options      QuestionOption[]
  media        QuestionMedia[]
  tags         QuestionTag[]
  concepts     QuestionConcept[]
  revisions    QuestionRevision[]
  statistics   QuestionStatistics?
  attempts     QuestionAttempt[]
  importId     String?
  import       QuestionImport? @relation(fields: [importId], references: [id])

  @@index([curriculumId, subjectId])
  @@index([topicId])
  @@index([conceptId])
  @@index([authorDifficulty])
  @@index([year])
  @@index([status])
  @@index([stemHash])
  @@index([language])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  key        String
  text       String
  order      Int      @default(0)
  isCorrect  Boolean  @default(false)

  @@unique([questionId, key])
  @@index([questionId])
}

model QuestionMedia {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  type       String
  url        String
  altText    String?
  order      Int      @default(0)
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([questionId])
}

model Tag {
  id        String        @id @default(cuid())
  name      String        @unique
  slug      String        @unique
  createdAt DateTime      @default(now())
  questions QuestionTag[]
}

model QuestionTag {
  questionId String
  tagId      String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@index([tagId])
}

model QuestionConcept {
  questionId String
  conceptId  String
  role       String @default("primary")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  concept    Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([questionId, conceptId])
  @@index([conceptId])
}

model QuestionRevision {
  id             String   @id @default(cuid())
  questionId     String
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  revisionNumber Int
  snapshot       Json
  changedBy      String?
  changeNote     String?
  createdAt      DateTime @default(now())

  @@unique([questionId, revisionNumber])
  @@index([questionId])
}

model QuestionStatistics {
  questionId            String   @id
  question              Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  totalAttempts         Int      @default(0)
  correctCount          Int      @default(0)
  incorrectCount        Int      @default(0)
  skipCount             Int      @default(0)
  averageTimeMs         Float?
  bookmarkCount         Int      @default(0)
  aiExplanationRequests Int      @default(0)
  popularityScore       Float    @default(0)
  updatedAt             DateTime @updatedAt
}

model QuestionImport {
  id             String   @id @default(cuid())
  importedById   String?
  importedBy     User?    @relation(fields: [importedById], references: [id])
  sourceFormat   String
  fileName       String?
  status         String   @default("completed")
  importedCount  Int      @default(0)
  skippedCount   Int      @default(0)
  duplicateCount Int      @default(0)
  errorCount     Int      @default(0)
  report         Json?
  createdAt      DateTime @default(now())

  questions Question[]

  @@index([importedById])
  @@index([createdAt])
}

model QuestionAttempt {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  quizAttemptId String?
  quizAttempt   QuizAttempt? @relation(fields: [quizAttemptId], references: [id])
  selectedKey   String?
  isCorrect     Boolean
  timeSpentMs   Int?
  skipped       Boolean      @default(false)
  createdAt     DateTime     @default(now())

  @@index([userId])
  @@index([questionId])
  @@index([quizAttemptId])
}

model QuizAttempt {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String?
  mode           String    @default("practice")
  status         String    @default("active")
  subjectIds     String[]
  topicIds       String[]  @default([])
  conceptIds     String[]  @default([])
  questionQueue  String[]  @default([])
  currentIndex   Int       @default(0)
  score          Float?
  totalQuestions Int       @default(0)
  correctCount   Int       @default(0)
  skippedCount   Int       @default(0)
  xpEarned       Int       @default(0)
  timeLimitSec   Int?
  config         Json?
  report         Json?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt
  attempts       QuestionAttempt[]

  @@index([userId])
  @@index([status])
  @@index([completedAt])
  @@index([mode])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode      String    @default("ask")
  title     String?
  subjectId String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([userId])
  @@index([mode])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  model          String?
  tokensUsed     Int?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Subscription {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               Plan
  provider           String    @default("paystack")
  providerRef        String?
  status             String
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([providerRef])
}
