// StudyMind Prisma Schema
// PostgreSQL (Supabase) + Prisma
// Modular, extensible for Learning Brain, Study Squads, marketplace, multi-curriculum
//
// Workflow: always use migrations, never db push after the initial setup.
//   npx prisma migrate dev --name <description>
//   npx prisma migrate deploy   (production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// AUTH & IDENTITY

model User {
  id            String    @id @default(cuid())
  clerkId       String    @unique
  email         String    @unique
  firstName     String?
  lastName      String?
  imageUrl      String?
  phone         String?

  country       String?
  curriculumId  String?
  curriculum    Curriculum? @relation(fields: [curriculumId], references: [id])
  level         String?
  primaryFocus  String?
  stressPoint   String?
  targetExamDate DateTime?
  weakSubjects  String[]
  learningGoals String[]
  preferredExplanationStyle String?
  dailyStudyTargetMin Int?
  timezone      String?
  onboardingDone Boolean  @default(false)

  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastStudyDate DateTime?
  totalStudyMinutes Int   @default(0)

  plan          Plan      @default(FREE)
  planExpiresAt DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subjectMasteries SubjectMastery[]
  conceptStates    ConceptState[]
  studyPlans       StudyPlan[]
  quizAttempts     QuizAttempt[]
  questionAttempts QuestionAttempt[]
  conversations    Conversation[]
  learningEvents   LearningEvent[]
  examDeadlines    ExamDeadline[]
  subscriptions    Subscription[]

  @@index([clerkId])
  @@index([email])
  @@index([curriculumId])
  @@index([onboardingDone])
}

enum Plan {
  FREE
  PRO
  EXAM_PASS
}

// CURRICULUM TAXONOMY

model Curriculum {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  country     String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subjects  Subject[]
  users     User[]
  questions Question[]

  @@index([code])
}

model Subject {
  id           String     @id @default(cuid())
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  code         String
  name         String
  description  String?
  order        Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  topics           Topic[]
  questions        Question[]
  subjectMasteries SubjectMastery[]
  studyPlanItems   StudyPlanItem[]
  examDeadlines    ExamDeadline[]

  @@unique([curriculumId, code])
  @@index([curriculumId])
}

model Topic {
  id          String   @id @default(cuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  concepts       Concept[]
  questions      Question[]
  studyPlanItems StudyPlanItem[]

  @@index([subjectId])
}

model Concept {
  id          String   @id @default(cuid())
  topicId     String
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  name        String
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  conceptStates ConceptState[]
  questions     Question[]

  // Concept graph edges
  prerequisitesFrom ConceptRelation[] @relation("ConceptFrom")
  prerequisitesTo   ConceptRelation[] @relation("ConceptTo")

  @@index([topicId])
}

/// Directed edge in the concept graph.
/// relationType: "prerequisite" | "related" | "part_of"
model ConceptRelation {
  id             String @id @default(cuid())
  fromConceptId  String
  toConceptId    String
  relationType   String @default("prerequisite")
  strength       Float  @default(1.0) // 0–1, how strongly related

  fromConcept Concept @relation("ConceptFrom", fields: [fromConceptId], references: [id], onDelete: Cascade)
  toConcept   Concept @relation("ConceptTo", fields: [toConceptId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([fromConceptId, toConceptId, relationType])
  @@index([fromConceptId])
  @@index([toConceptId])
  @@index([relationType])
}

// LEARNING BRAIN

model SubjectMastery {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  masteryScore    Float    @default(0)
  confidence      Float    @default(0)
  questionsAttempted Int   @default(0)
  questionsCorrect   Int   @default(0)
  lastPracticedAt DateTime?
  updatedAt       DateTime @updatedAt

  @@unique([userId, subjectId])
  @@index([userId])
  @@index([subjectId])
}

model ConceptState {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conceptId       String
  concept         Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  masteryScore    Float    @default(0)  // 0–100 knowledge estimate
  confidence      Float    @default(0)  // 0–100 consistency / non-guessing
  easeFactor      Float    @default(2.5)
  intervalDays    Int      @default(0)
  repetitions     Int      @default(0)
  nextReviewAt    DateTime?
  lastReviewedAt  DateTime?
  // Rolling consistency window (last N results as bit flags stored compactly)
  recentResults   String   @default("") // e.g. "10110" most-recent last
  updatedAt       DateTime @updatedAt

  @@unique([userId, conceptId])
  @@index([userId])
  @@index([conceptId])
  @@index([nextReviewAt])
}

model LearningEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type])
}

// STUDY PLANNING

model StudyPlan {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String?
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean  @default(true)
  generatedBy String   @default("system")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items StudyPlanItem[]

  @@index([userId, isActive])
}

model StudyPlanItem {
  id          String    @id @default(cuid())
  planId      String
  plan        StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     Subject?  @relation(fields: [subjectId], references: [id])
  topicId     String?
  topic       Topic?    @relation(fields: [topicId], references: [id])

  title       String
  description String?
  type        String
  durationMin Int       @default(20)
  scheduledFor DateTime
  completedAt DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([planId])
  @@index([scheduledFor])
}

model ExamDeadline {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id])
  title       String
  examDate    DateTime
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([examDate])
}

// QUESTION BANK

model Question {
  id           String     @id @default(cuid())
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id])
  subjectId    String
  subject      Subject    @relation(fields: [subjectId], references: [id])
  topicId      String?
  topic        Topic?     @relation(fields: [topicId], references: [id])
  conceptId    String?
  concept      Concept?   @relation(fields: [conceptId], references: [id])

  type         QuestionType @default(MULTIPLE_CHOICE)
  difficulty   Int          @default(3)
  stem         String
  options      Json?
  correctKey   String?

  explanation        String?
  commonMistakes     Json?
  learningObjectives String[]
  estimatedTimeSec   Int?
  source             String?
  year               Int?
  tags               String[]

  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attempts QuestionAttempt[]

  @@index([curriculumId, subjectId])
  @@index([topicId])
  @@index([conceptId])
  @@index([difficulty])
  @@index([year])
}

enum QuestionType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
  ESSAY
  TRUE_FALSE
}

model QuestionAttempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  quizAttemptId String?
  quizAttempt QuizAttempt? @relation(fields: [quizAttemptId], references: [id])

  selectedKey String?
  isCorrect   Boolean
  timeSpentMs Int?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([questionId])
  @@index([quizAttemptId])
}

// QUIZZES

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String?
  mode        String   @default("practice")
  subjectIds  String[]
  score       Float?
  totalQuestions Int
  correctCount Int     @default(0)
  startedAt   DateTime @default(now())
  completedAt DateTime?
  timeLimitSec Int?

  attempts QuestionAttempt[]

  @@index([userId])
  @@index([completedAt])
}

// AI CONVERSATIONS

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode      String   @default("ask")
  title     String?
  subjectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([userId])
  @@index([mode])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  model          String?
  tokensUsed     Int?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

// SUBSCRIPTIONS

model Subscription {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              Plan
  provider          String   @default("paystack")
  providerRef       String?
  status            String
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([providerRef])
}
